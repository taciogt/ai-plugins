#!/usr/bin/env bash
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a ref
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    base=$(git merge-base origin/main "$local_sha")
  else
    base=$remote_sha
  fi
  scripts/check-plugin-versions.sh "$base" "$local_sha"
  changed=$(git diff --name-only "$base" "$local_sha" -- plugins/ | cut -d/ -f2 | sort -u)
  if [ -n "$changed" ]; then
    # shellcheck disable=SC2086
    scripts/check-plugins.sh $changed
  fi
done
